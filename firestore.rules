rules_version = '2';

/* ===========================================================
   TODA a segurança do app mora aqui. O firebaseConfig no
   app.js é público: ele identifica o projeto, não autoriza.
   Princípio: o cliente NÃO PODE SE PROMOVER.

   As coleções abaixo têm que casar com as constantes do
   app.js (COL_LANC e COL_POL). Divergir aqui não quebra a
   tela: só impede silenciosamente de gravar.
   =========================================================== */
service cloud.firestore {
  match /databases/{database}/documents {

    function logado()  { return request.auth != null; }
    function eu(uid)   { return logado() && request.auth.uid == uid; }
    function meuDoc()  { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }

    /* Os donos do app. Resolve o ovo e a galinha da portaria: sem isto, o
       primeiro usuário nasce pendente e não existe ninguém para aprová-lo,
       e a saída era editar o documento à mão no console.
       E-mail aqui NÃO é segredo: quem protege é a comparação com o token
       verificado do Google, não o sigilo da lista. */
    function donos() { return ['luiz.brasil@fgv.br', 'luizbrasil.rj@gmail.com']; }
    function ehDono() { return logado() && request.auth.token.get('email','') in donos(); }

    // admin pode vir por ser dono, pelo array roles OU pelo campo string papel.
    // ehDono() vem primeiro de propósito: ele não depende do documento existir.
    function ehAdmin() { return ehDono() || (logado() && (meuDoc().roles.hasAny(['admin'])
                                                          || meuDoc().get('papel','') == 'admin')); }
    function aprovado(){ return ehDono() || (logado() && meuDoc().status == 'aprovado'); }

    match /users/{uid} {
      allow get:  if eu(uid) || ehAdmin();
      allow list: if ehAdmin();                       // ninguém enumera a base

      // A portaria começa aqui: quem não é dono entra pendente e member.
      // O dono nasce aprovado e admin — é o único jeito de a portaria ter
      // um porteiro no primeiro acesso.
      allow create: if eu(uid)
                    && request.resource.data.keys().hasOnly(
                         ['nome','email','foto','roles','status','criadoEm','papel'])
                    && request.resource.data.roles is list
                    && (ehDono()
                          ? request.resource.data.status == 'aprovado'
                          : (request.resource.data.roles == ['member']
                             && request.resource.data.status == 'pendente'
                             && !('papel' in request.resource.data)));

      // O dono mexe só nas preferências e nos dados vindos do Google.
      // roles, status e papel saem idênticos aos que entraram.
      allow update: if ehAdmin()
                    || (eu(uid)
                        && request.resource.data.roles  == resource.data.roles
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.get('papel','') == resource.data.get('papel','')
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['prefs','nome','email','foto']));

      allow delete: if ehAdmin();
    }

    // Os lançamentos de cada pessoa: um documento por uid.
    // Só grava quem já foi aprovado. Valide SEMPRE forma e tamanho,
    // senão qualquer aprovado pode inflar o seu banco.
    match /lancamentos/{uid} {
      allow read:  if eu(uid) || ehAdmin();
      allow write: if eu(uid) && aprovado()
                   && request.resource.data.itens is list
                   && request.resource.data.itens.size() <= 1500
                   && request.resource.data.keys().hasOnly(['itens','atualizadoEm']);
    }

    // Regra do RH (teto por refeição e taxa, com vigência):
    // todo aprovado lê, só o administrador escreve.
    match /politicas/{doc} {
      allow read:  if aprovado() || ehAdmin();
      allow write: if ehAdmin()
                   && request.resource.data.lista is list
                   && request.resource.data.lista.size() <= 200
                   && request.resource.data.keys().hasOnly(['lista','atualizadoEm']);
    }

    match /{document=**} { allow read, write: if false; }
  }
}
